# Copy to .dev.vars for local development. Never commit .dev.vars.
# Production: `npx wrangler pages secret put <NAME>` for each of these.

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=

# Cloudflare Turnstile (these are Cloudflare's always-pass test keys)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# R2 S3-compatible credentials, used only to sign presigned PUT/GET URLs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
