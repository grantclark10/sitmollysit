---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="section">
    <div class="container center stack" style="--stack: 1.25rem">
      <p class="eyebrow">404</p>
      <h1>This page has wandered off.</h1>
      <p>Even the best-trained pets don’t always sit when asked. Let’s get you back on track.</p>
      <p><a class="btn" href="/">Back to home</a></p>
    </div>
  </section>
</Base>
