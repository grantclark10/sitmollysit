---
import { Picture } from 'astro:assets';
import photo from '../../assets/pets/murphy.jpg';
---

<section class="split" aria-labelledby="bespoke-title">
  <div class="split__text">
    <h2 id="bespoke-title">Have a bespoke request?</h2>
    <p>
      Simply send us a mail and let us know what you have in mind for your furry family. We’d love to see if we could
      help you bring your vision to life.
    </p>
    <a class="btn btn--light" href="/contact">Say Hello</a>
  </div>
  <div class="split__media">
    <Picture
      src={photo}
      alt="Murphy, a bulldog, lying with a tennis ball on a dark studio background"
      formats={['avif', 'webp']}
      widths={[480, 720, 960]}
      sizes="(min-width: 800px) 50vw, 100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .split__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: var(--section) var(--gutter);
    background: var(--mint);
    text-align: center;
  }
  h2 {
    font-size: var(--fs-xl);
  }
  p {
    max-width: 26rem;
    font-size: var(--fs-sm);
  }
  .split__media {
    background: var(--black);
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .split__media :global(picture),
  .split__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  @media (min-width: 800px) {
    .split {
      grid-template-columns: 5fr 7fr;
      min-height: 560px;
    }
    .split__media {
      aspect-ratio: auto;
      max-height: 720px;
    }
  }
</style>
