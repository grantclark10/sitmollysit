---
import { Picture } from 'astro:assets';
import heroImage from '../../assets/pets/harvey.jpg';
---

<section class="hero" aria-labelledby="hero-title">
  <Picture
    class="hero__img"
    src={heroImage}
    alt=""
    formats={['avif', 'webp']}
    widths={[640, 960, 1280, 1700]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__overlay">
    <h1 id="hero-title">Timeless Pet Portraits</h1>
    <p>They’re family. We understand.</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: clamp(420px, 72vh, 760px);
    background: var(--black);
    overflow: hidden;
  }
  .hero > :global(picture),
  .hero :global(.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero :global(.hero__img) {
    object-fit: cover;
    object-position: 50% 35%;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.15) 60%, rgb(0 0 0 / 0.25));
  }
  .hero__overlay {
    position: relative;
    z-index: 1;
    align-self: end;
    padding: var(--section) var(--gutter) clamp(2.5rem, 8vh, 5rem);
    text-align: center;
    color: var(--white);
  }
  h1 {
    color: var(--white);
  }
  p {
    margin-top: 0.5rem;
    font-size: var(--fs-lg);
    font-weight: 300;
  }
</style>
